# Settings for pwa-next.  Readable by root and the "pwa" service account only.
# After changing anything here: systemctl reload httpd

# Who signs people in.  "oidc" = Apache did it and passed REMOTE_USER on
# (mod_auth_openidc with CILogon, or any other Apache authentication module).
PWA_AUTH=oidc

# PostgreSQL over the local socket, as the "pwa" operating-system account:
# no password to store.  One-time setup:
#   sudo -u postgres createuser pwa
#   sudo -u postgres createdb -O pwa -E UTF8 -T template0 pwa
PWA_DATABASE_URL=postgresql:///pwa

# Where published files go (Apache serves this directory) and its public URL.
PWA_PUBLISH_DIR=/var/lib/pwa/pub
PWA_PUBLIC_URL=https://CHANGE-ME.example.org/pub

# Subjects (or e-mail addresses) made service administrators at first login.
PWA_ADMINS=

# Signs the browser session cookie.  REQUIRED.  Generate one with:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
PWA_SECRET_KEY=
# ...or keep it in a file of its own (readable by root and group pwa):
#PWA_SECRET_KEY_FILE=/etc/pwa/secret.key

# Shown in the page header.
PWA_SITE_NAME=pSConfig Web Admin
