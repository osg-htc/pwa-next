# Managed by Ansible (playbooks/pwa.yaml). Apache configuration for pwa-next.
#
# TLS itself is left to /etc/httpd/conf.d/ssl.conf (hostcert.yaml sets the certificate).
#
# Order matters in this file: Apache applies <Location> sections in the order
# they appear, so the sections that open /pub/ and /static/ to everyone must
# stay AFTER the sign-in section.

# --- what toolkits read: plain files, no login, no application -------------
AliasMatch ^/pub/config/?$     /var/lib/pwa/pub/index.json
AliasMatch ^/pub/config/(.+)$  /var/lib/pwa/pub/config/$1
AliasMatch ^/pub/auto/(.+)$    /var/lib/pwa/pub/auto/$1
<Directory /var/lib/pwa/pub>
    Options None
    AllowOverride None
    ForceType application/json
    Header set Cache-Control "no-cache"
</Directory>

# Stylesheet and scripts also come straight from Apache, so a visitor who has
# not signed in never reaches the application at all.
Alias /static/ /usr/share/pwa-next/static/
Alias /favicon.ico /usr/share/pwa-next/static/brand/favicon.ico
<Directory /usr/share/pwa-next/static>
    Options FollowSymLinks
    AllowOverride None
</Directory>

# --- the application ---------------------------------------------------------
WSGIDaemonProcess pwa user=pwa group=pwa processes=2 threads=8 display-name=%{GROUP}
WSGIScriptAlias / /usr/share/pwa-next/pwa.wsgi process-group=pwa application-group=%{GLOBAL}
<Directory /usr/share/pwa-next>
    Require all granted
</Directory>

# Never run the application over plain HTTP; published files stay reachable.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{REQUEST_URI} !^/pub/
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# --- sign-in -----------------------------------------------------------------
{% if pwa_signin == "oidc" %}
# CILogon (institution logins). The client id and secret are in a root-only file
# that is not in SVN: two lines, "OIDCClientID ..." and "OIDCClientSecret ...".
OIDCProviderMetadataURL https://cilogon.org/.well-known/openid-configuration
Include /etc/httpd/pwa-oidc-client.conf
OIDCRedirectURI         https://{{ pwa_public_name }}/oidc/redirect
OIDCCryptoPassphrase    "exec:/usr/bin/cat /etc/httpd/pwa-oidc-passphrase"
OIDCScope               "openid email profile org.cilogon.userinfo"
OIDCRemoteUserClaim     sub
OIDCPassClaimsAs        environment
<Location />
    AuthType openid-connect
    Require valid-user
</Location>
{% else %}
# Password file, for the first tests on the private network.
<Location />
    AuthType Basic
    AuthName "pSConfig Web Admin"
    AuthUserFile /etc/httpd/pwa-htpasswd
    Require valid-user
</Location>
{% endif %}
# --- end of sign-in options --------------------------------------------------

# --- open to everyone (keep these last) -------------------------------------
<Location /pub/>
    AuthType None
    Require all granted
</Location>
<Location /static/>
    AuthType None
    Require all granted
</Location>
<Location /favicon.ico>
    AuthType None
    Require all granted
</Location>
