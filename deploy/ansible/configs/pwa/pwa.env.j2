# Managed by Ansible (playbooks/pwa.yaml). Settings for pwa-next.
PWA_AUTH=oidc
PWA_DATABASE_URL=postgresql:///pwa
PWA_PUBLISH_DIR=/var/lib/pwa/pub
PWA_PUBLIC_URL=https://{{ pwa_public_name }}/pub
PWA_ADMINS={{ pwa_admins }}
PWA_SECRET_KEY_FILE=/etc/pwa/secret.key
PWA_SITE_NAME=pSConfig Web Admin (test)
{% if pwa_registry_ca %}
# CA added for pwa site-sync (WLCG CRIC's chain ends at CERN Root CA 2)
PWA_REGISTRY_CA=/etc/pwa/registry-ca.pem
{% endif %}
