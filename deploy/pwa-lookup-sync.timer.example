# systemd timer SKETCH: refresh the host inventory every hour.
# pwa-lookup-sync.service:  ExecStart=/usr/bin/python3 -m pwa lookup-sync
#                           User=pwa   Environment=PWA_CONFIG=/etc/pwa/pwa.env
[Unit]
Description=Refresh the pwa host inventory from the perfSONAR Lookup Service

[Timer]
OnCalendar=hourly
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
